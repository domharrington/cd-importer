# Copy to .env.local (gitignored) and edit. Every script reads it if present, so
# your own host, paths and contact address stay out of the repo.
#
#     cp config.example.env .env.local

# Where the Navidrome library lives, and how to reach it.
MUSIC_HOST=music-server.local
MUSIC_PATH=/srv/music
# Somewhere outside MUSIC_PATH, so Navidrome stops indexing what is moved there.
SUPERSEDED_PATH=/srv/_superseded

# MusicBrainz requires a contact address or URL in the User-Agent, and will
# throttle or block requests without one. An email or a project URL both work.
MB_CONTACT=you@example.com

# Navidrome's Docker container, used only to trigger a rescan.
NAVIDROME_CONTAINER=navidrome-navidrome-1

# Spotify app Client ID, from https://developer.spotify.com/dashboard
# Redirect URI must be exactly http://127.0.0.1:8888/callback
# No client secret: spotify_export.py uses the PKCE flow.
SPOTIFY_CLIENT_ID=
